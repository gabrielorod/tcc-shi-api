generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
}

enum TipoRecipiente {
  COPO
  GARRAFA
  CANECA
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  pesoKg       Int      @map("peso_kg")
  alturaCm     Int      @map("altura_cm")
  sexo         Sexo
  metaDiariaMl Int      @map("meta_diaria_ml")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  recipientes        Recipiente[]
  dispositivosAtivos Dispositivo[]   @relation("UsuarioAtivo")
  logs               LogHidratacao[]
  dispositivos       Dispositivo[]

  @@map("usuarios")
}

model Recipiente {
  id         String         @id @default(uuid())
  usuarioId  String         @map("usuario_id")
  nome       String
  tipo       TipoRecipiente
  pesoVazioG Int            @default(0) @map("peso_vazio_g")
  ativo      Boolean        @default(true)
  criadoEm   DateTime       @default(now()) @map("criado_em")

  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  logs        LogHidratacao[]
  dispositivo Dispositivo?

  @@map("recipientes")
}

model Dispositivo {
  id                 String    @id @default(uuid())
  tokenAcesso        String    @unique @map("token_acesso")
  usuarioAtivoId     String?   @map("usuario_ativo_id")
  recipienteAtivoId  String?   @unique @map("recipiente_ativo_id")
  pesoAtualNaMesaG   Int       @default(0) @map("peso_atual_na_mesa_g")
  ultimoPingEm       DateTime? @map("ultimo_ping_em")
  gracePeriodMinutos Int       @default(30) @map("grace_period_minutos")
  criadoEm           DateTime  @default(now()) @map("criado_em")

  usuarioAtivo    Usuario?             @relation("UsuarioAtivo", fields: [usuarioAtivoId], references: [id])
  recipienteAtivo Recipiente?          @relation(fields: [recipienteAtivoId], references: [id])
  logs            LogHidratacao[]
  comandos        ComandoDispositivo[]
  usuario         Usuario?             @relation(fields: [usuarioId], references: [id])
  usuarioId       String?

  @@map("dispositivos")
}

model LogHidratacao {
  id            String   @id @default(uuid())
  usuarioId     String   @map("usuario_id")
  dispositivoId String   @map("dispositivo_id")
  recipienteId  String   @map("recipiente_id")
  quantidadeMl  Int      @map("quantidade_ml")
  pesoAntesG    Int      @map("peso_antes_g")
  pesoDepoisG   Int      @map("peso_depois_g")
  registradoEm  DateTime @default(now()) @map("registrado_em")

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id])
  recipiente  Recipiente  @relation(fields: [recipienteId], references: [id])

  @@index([usuarioId, registradoEm])
  @@map("logs_hidratacao")
}

model ComandoDispositivo {
  id            String   @id @default(uuid())
  dispositivoId String   @map("dispositivo_id")
  comando       String
  parametro     String?
  executado     Boolean  @default(false)
  criadoEm      DateTime @default(now()) @map("criado_em")

  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  @@index([dispositivoId, executado])
  @@map("comandos_dispositivo")
}
